# Hostname should resolve from the private Docker/network environment.
GROBID_URL=http://localhost:8070/
GROBID_TIMEOUT_SECONDS=300
GROBID_HEALTH_TIMEOUT_SECONDS=5
MAX_UPLOAD_MB=20

# SBERT (`POST /v1/embeddings`). The model downloads from Hugging Face on first
# use (~1 GB); set HF_HOME to a persistent directory so it is not re-downloaded.
SBERT_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_TEXTS=256
EMBEDDING_MAX_TEXT_CHARS=2000
# Load the model in the background at startup so the first request is not slow.
SBERT_PRELOAD=true
