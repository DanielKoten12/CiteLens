# Compose variable overrides for `docker compose` (see docker/README.md).
#
# Every variable below has a working development default in compose.yaml, so
# this file is only needed when you want to change something. Copy it to `.env`
# (git-ignored) before editing — never commit real credentials or APP_KEYs.

# Project / image prefix.
COMPOSE_PROJECT_NAME=dafpus

# Published ports (web = Laravel API, frontend = SPA).
WEB_PORT=8000
FRONTEND_PORT=5173
FRONTEND_PROD_PORT=8080

# PostgreSQL (development-only credentials; override for anything shared).
POSTGRES_DB=dafpus
POSTGRES_USER=dafpus
POSTGRES_PASSWORD=dafpus

# Laravel application settings passed into the containers.
APP_NAME="Dafpus Cek"
APP_ENV=local
APP_DEBUG=true
# Leave empty to let the containers generate and persist one on the storage
# volume (development). Production must pin a real value: `php artisan key:generate --show`.
APP_KEY=
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Crossref polite pool contact (docs/API_SPEC.md §1). Set in real environments.
CROSSREF_MAILTO=

# Supplemental metadata sources (docs/plans/backend/09-multi-source-metadata-search.md).
# Both are key-gated: an empty key keeps the source disabled (remove the key to
# disable a source in Docker). Keys are sent in request headers, never in URLs;
# never commit real values. `*_ENABLED` toggles exist for non-Docker .env files.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
# Falls back to CROSSREF_MAILTO when unset.
# OPENALEX_MAILTO=

# Per-source outage policy (fatal | degrade) and fallback budgets. The chain
# order itself lives in config/analysis.php, not here.
# METADATA_FAILURE_POLICY_CROSSREF=fatal
# METADATA_FAILURE_POLICY_GARUDA=fatal
# METADATA_FAILURE_POLICY_SEMANTIC_SCHOLAR=degrade
# METADATA_FAILURE_POLICY_OPENALEX=degrade
# ANALYSIS_METADATA_STOP_POLICY=plausible_title_with_doi
# ANALYSIS_METADATA_MAX_FALLBACK_REQUESTS=300
# ANALYSIS_METADATA_MAX_FALLBACK_SECONDS=300
# ANALYSIS_METADATA_MAX_CANDIDATES=10
# ANALYSIS_METADATA_CIRCUIT_BREAKER=true
# ANALYSIS_METADATA_CIRCUIT_THRESHOLD=3
# ANALYSIS_METADATA_CIRCUIT_COOLDOWN=120

# SBERT (`POST /v1/embeddings`) is not implemented yet; a 404 from the internal
# inference service is fatal to the pipeline `embedding` step, so semantic
# scoring stays disabled in Docker until Phase 02 lands.
SCORING_SEMANTIC_ENABLED=false

# Host ports used by the optional debug overlay (compose.debug.yaml).
POSTGRES_DEBUG_PORT=5432
GROBID_DEBUG_PORT=8070
INFERENCE_DEBUG_PORT=8001
GOTENBERG_DEBUG_PORT=3000

# Hosted GROBID used by the optional remote overlay (compose.remote-grobid.yaml).
# ⚠ That overlay sends every uploaded PDF to this host over the public internet;
# it is meant for demos and throwaway documents only (docker/README.md §5).
# Leave unset to use the public GROBID Space.
REMOTE_GROBID_URL=https://grobidorg-grobid-full2.hf.space
